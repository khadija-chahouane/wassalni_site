-- 1. تعديل جدول السيارات أو الرحلات باش يولي يدعم الرحلات الحضرية (داخل المدينة)
-- نقدروا نعتبروا ville_depart و ville_arrivee يقبلوا حتى أسماء الأحياء والأقسام داخل المدينة
ALTER TABLE vehicles 
    ADD COLUMN IF NOT EXISTS type_trajet ENUM('inter_ville', 'intra_ville') NOT NULL DEFAULT 'inter_ville',
    ADD COLUMN IF NOT EXISTS quartier_depart VARCHAR(150) NULL,
    ADD COLUMN IF NOT EXISTS quartier_arrivee VARCHAR(150) NULL;

-- 2. جدول لتتبع طلبات السائق (Ride Requests / Matching)
CREATE TABLE IF NOT EXISTS ride_requests (
    id INT AUTO_INCREMENT PRIMARY KEY,
    client_id INT NOT NULL,
    driver_id INT NULL,
    lieu_depart VARCHAR(150) NOT NULL,
    lieu_arrivee VARCHAR(150) NOT NULL,
    prix_propose DECIMAL(10,2) NOT NULL,
    statut ENUM('en_attente', 'acceptee', 'refusee', 'terminee') NOT NULL DEFAULT 'en_attente',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (client_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (driver_id) REFERENCES users(id) ON DELETE SET NULL
);
USE transport_db;

-- 1. إضافة تفضيل الجنس في جدول المستخدمين والسيارات
ALTER TABLE users 
    ADD COLUMN IF NOT EXISTS preferred_gender_match VARCHAR(20) DEFAULT 'any';

ALTER TABLE vehicles 
    ADD COLUMN IF NOT EXISTS driver_gender VARCHAR(20) DEFAULT 'ذكر';

-- 2. تحديث جدول طلبات الرحلات لدعم التفاوض والكيلومترات
DROP TABLE IF EXISTS ride_requests;
CREATE TABLE ride_requests (
    id INT AUTO_INCREMENT PRIMARY KEY,
    client_id INT NOT NULL,
    driver_id INT NULL,
    lieu_depart VARCHAR(150) NOT NULL,
    lieu_arrivee VARCHAR(150) NOT NULL,
    distance_km DECIMAL(6,2) NOT NULL,
    prix_propose DECIMAL(10,2) NOT NULL, -- الثمن المقترح من طرف الكليون
    prix_chauffeur DECIMAL(10,2) NULL,  -- الثمن المقترح أو المعدل من طرف الشيفور
    statut ENUM('en_attente', 'negociation', 'acceptee', 'refusee', 'terminee') NOT NULL DEFAULT 'en_attente',
    created_at TIMESTAMP DEFAULT CURRENT_TIMESTAMP,
    FOREIGN KEY (client_id) REFERENCES users(id) ON DELETE CASCADE,
    FOREIGN KEY (driver_id) REFERENCES users(id) ON DELETE SET NULL
);